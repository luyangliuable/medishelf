name: medishelf

services:
  - name: web
    environment_slug: node-js
    github:
      repo: YOUR_GITHUB_ORG_OR_USER/YOUR_REPO
      branch: main
      deploy_on_push: true
    build_command: npm ci && npm run build
    run_command: npm run start
    http_port: 3000
    instance_count: 1
    instance_size_slug: basic-xxs
    envs:
      - key: DATABASE_URL
        scope: RUN_TIME
        type: SECRET
      - key: DATABASE_SSL_REJECT_UNAUTHORIZED
        scope: RUN_TIME
        value: "false"
      - key: SESSION_SECRET
        scope: RUN_TIME
        type: SECRET
      - key: NEXT_PUBLIC_APP_URL
        scope: RUN_TIME
        value: https://YOUR_APP_DOMAIN
      - key: UPLOAD_DIR
        scope: RUN_TIME
        value: /tmp/uploads
      - key: LLM_PROVIDER
        scope: RUN_TIME
        value: openai-compatible
      - key: LLM_BASE_URL
        scope: RUN_TIME
        value: https://api.openai.com/v1
      - key: LLM_API_KEY
        scope: RUN_TIME
        type: SECRET
      - key: LLM_MODEL
        scope: RUN_TIME
        value: gpt-4.1-mini
      - key: LLM_HEADERS_JSON
        scope: RUN_TIME
        value: "{}"

jobs:
  - name: db-migrate
    kind: PRE_DEPLOY
    environment_slug: node-js
    github:
      repo: YOUR_GITHUB_ORG_OR_USER/YOUR_REPO
      branch: main
      deploy_on_push: true
    run_command: npm ci --include=dev && npm run do:predeploy
    envs:
      - key: DATABASE_URL
        scope: RUN_TIME
        type: SECRET
      - key: DATABASE_SSL_REJECT_UNAUTHORIZED
        scope: RUN_TIME
        value: "false"
